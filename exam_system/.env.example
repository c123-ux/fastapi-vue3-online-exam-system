# 环境配置模板：复制为 .env 后填写真实值（.env 已入 .gitignore，禁止提交）

# MySQL 8.0.46 @ 3307（本机实测；3306 是 MySQL 9.3）
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3307/exam_db?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3307/exam_test?charset=utf8mb4

# 原生 Redis 5.0.14.1（无 Docker）；dev=db0，test=db1（项目四起用 db2）
REDIS_URL=redis://127.0.0.1:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/1

# JWT：生成用 python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
# 必须 >= 最长考试时长 + 宽限（否则学生第 N 分钟交不了卷，D1 NFR-03）
ACCESS_TOKEN_EXPIRE_MINUTES=240

# 超时宽限秒数（决策 #4）
EXAM_GRACE_SECONDS=30

# 教师注册码：不配置则不开放 teacher 注册（D1 EC-26）
TEACHER_REGISTER_CODE=
